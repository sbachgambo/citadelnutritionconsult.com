{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Base (soft white)", "color": "#FBFBF9" },
				{ "slug": "surface", "name": "Surface (light gray)", "color": "#F2F2EF" },
				{ "slug": "contrast", "name": "Contrast (near-black text)", "color": "#1C2321" },
				{ "slug": "contrast-2", "name": "Contrast muted (body text)", "color": "#44504B" },
				{ "slug": "accent", "name": "Accent (official brand olive green #8FA84A, darkened for AA contrast)", "color": "#677935" },
				{ "slug": "accent-2", "name": "Accent light (sage tint)", "color": "#E8ECDA" },
				{ "slug": "border", "name": "Border", "color": "#E1E1DC" }
			],
			"gradients": []
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Heading",
					"fontFamily": "\"Fraunces\", \"Georgia\", serif"
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.125rem" },
				{ "slug": "large", "name": "Large", "size": "1.5rem" },
				{ "slug": "x-large", "name": "X-Large", "size": "2.25rem" },
				{ "slug": "xx-large", "name": "XX-Large", "size": "3.25rem" }
			],
			"fluid": true
		},
		"spacing": {
			"units": ["px", "%", "em", "rem", "vh", "vw"],
			"spacingScale": {
				"steps": 7
			}
		},
		"custom": {
			"spacing": {
				"section-gap": "clamp(3rem, 6vw, 7rem)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast-2)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600",
					"lineHeight": "1.15"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": {
					"radius": "6px"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)"
					}
				}
			}
		},
		"blocks": {
			"core/post-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-about-michelle", "title": "About Michelle Full Page", "postTypes": ["page"] },
		{ "name": "page-services", "title": "Services Full Page", "postTypes": ["page"] },
		{ "name": "page-communities", "title": "CNC Communities", "postTypes": ["page"] },
		{ "name": "page-blog", "title": "Blog Listing", "postTypes": ["page"] },
		{ "name": "page-shop", "title": "CNC Smartfoods Landing", "postTypes": ["page"] },
		{ "name": "page-learn", "title": "Learn Landing", "postTypes": ["page"] },
		{ "name": "page-book", "title": "Book a Consultation", "postTypes": ["page"] }
	]
}
